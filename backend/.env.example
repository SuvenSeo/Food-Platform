APP_ENV=development
APP_NAME=Food Price Intelligence API
API_PREFIX=/api/v1
ADMIN_API_KEY=change-me
# development/test: true keeps local SQLite fallback ergonomic
# staging/production: set false and provide DATABASE_URL
ALLOW_SQLITE_FALLBACK=true
# For local dev you can leave DATABASE_URL empty to use SQLite fallback.
# For Supabase/Postgres set: postgresql+psycopg://<user>:<password>@<host>:5432/<db>
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCRAPER_USER_AGENT=FoodPlatformBot/0.1 (+contact: admin@example.com)
SCRAPE_MAX_ITEMS_PER_SOURCE=250
SPAR2U_ENABLED=true
GLOMARK_ENABLED=true
MARKET_QUOTES_URL=
MARKET_QUOTES_TIMEOUT_SECONDS=15
MARKET_QUOTES_FORMAT=json
MARKET_QUOTES_SEED_FALLBACK_ENABLED=true
