APP_ENV=development
APP_NAME=Food Price Intelligence API
API_PREFIX=/api/v1
ADMIN_API_KEY=change-me
ALLOW_SQLITE_FALLBACK=true
DATABASE_URL=sqlite:///./food_platform.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCRAPER_USER_AGENT=FoodPlatformBot/0.1 (+contact: admin@example.com)
SCRAPE_MAX_ITEMS_PER_SOURCE=250
SPAR2U_ENABLED=true
GLOMARK_ENABLED=true
